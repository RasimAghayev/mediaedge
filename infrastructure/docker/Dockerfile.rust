# syntax=docker/dockerfile:1
# Stage 1: Generate lock file with xattr replace directive
FROM --platform=$BUILDPLATFORM rust:1.96 AS lockgen
WORKDIR /mediaedge
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libasound2-dev \
    libudev-dev \
    clang \
    libclang-dev \
    nasm \
    git \
    wget \
    build-essential \
    yasm \
    libx264-dev \
    libx265-dev \
    libvpx-dev \
    libmp3lame-dev \
    libopus-dev \
    libvorbis-dev \
    libtheora-dev \
    libass-dev \
    libfreetype6-dev \
    && rm -rf /var/lib/apt/lists/*
# Build FFmpeg 6.1 from source
RUN cd /tmp && \
    wget https://ffmpeg.org/releases/ffmpeg-6.1.1.tar.bz2 && \
    tar xjf ffmpeg-6.1.1.tar.bz2 && \
    cd ffmpeg-6.1.1 && \
    ./configure --prefix=/usr/local --enable-gpl --enable-libx264 --enable-libx265 --enable-libvpx --enable-libmp3lame --enable-libopus --enable-libvorbis --enable-libtheora --enable-libass --enable-libfreetype --enable-shared && \
    make -j$(nproc) && \
    make install && \
    ldconfig && \
    rm -rf /tmp/ffmpeg-6.1.1*
COPY Cargo.toml ./
COPY .cargo .cargo
COPY crates crates
COPY services services
RUN cargo generate-lockfile
# Patch xattr 0.2.3 to fix ENOATTR issue (use ENOSTR instead)
RUN sed -i 's/::libc::ENOATTR/::libc::ENOSTR/g' /usr/local/cargo/registry/src/index.crates.io-*/xattr-0.2.3/src/sys/mod.rs 2>/dev/null || true

# Stage 2: Chef - prepare recipe using pre-generated lock file
FROM --platform=$BUILDPLATFORM rust:1.96 AS chef
WORKDIR /mediaedge
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libasound2-dev \
    libudev-dev \
    clang \
    libclang-dev \
    nasm \
    git \
    wget \
    build-essential \
    yasm \
    libx264-dev \
    libx265-dev \
    libvpx-dev \
    libmp3lame-dev \
    libopus-dev \
    libvorbis-dev \
    libtheora-dev \
    libass-dev \
    libfreetype6-dev \
    && rm -rf /var/lib/apt/lists/*
# Build FFmpeg 6.1 from source
RUN cd /tmp && \
    wget https://ffmpeg.org/releases/ffmpeg-6.1.1.tar.bz2 && \
    tar xjf ffmpeg-6.1.1.tar.bz2 && \
    cd ffmpeg-6.1.1 && \
    ./configure --prefix=/usr/local --enable-gpl --enable-libx264 --enable-libx265 --enable-libvpx --enable-libmp3lame --enable-libopus --enable-libvorbis --enable-libtheora --enable-libass --enable-libfreetype --enable-shared && \
    make -j$(nproc) && \
    make install && \
    ldconfig && \
    rm -rf /tmp/ffmpeg-6.1.1*
RUN cargo install cargo-chef
COPY --from=lockgen /mediaedge/Cargo.lock Cargo.lock
COPY Cargo.toml ./
COPY .cargo .cargo
COPY crates crates
COPY services services
# Patch xattr in chef stage too (for cargo chef prepare)
RUN sed -i 's/::libc::ENOATTR/::libc::ENOSTR/g' /usr/local/cargo/registry/src/index.crates.io-*/xattr-0.2.3/src/sys/mod.rs 2>/dev/null || true
RUN cargo chef prepare --recipe-path recipe.json

# Stage 3: Planner - cook dependencies using locked deps
FROM chef AS planner
WORKDIR /mediaedge
COPY --from=chef /mediaedge/Cargo.lock Cargo.lock
COPY --from=chef /mediaedge/recipe.json recipe.json
# Fetch deps first, then patch xattr, then cook
RUN cargo fetch --locked
RUN sed -i 's/::libc::ENOATTR/::libc::ENOSTR/g' /usr/local/cargo/registry/src/index.crates.io-*/xattr-0.2.3/src/sys/mod.rs 2>/dev/null || true
RUN cargo chef cook --release --locked --recipe-path recipe.json

# Stage 4: Builder - build the actual project
FROM chef AS builder
WORKDIR /mediaedge
COPY --from=planner /mediaedge/target target
COPY --from=planner /mediaedge/recipe.json recipe.json
RUN cargo build --release --workspace

# Stage 5: Runtime - distroless
FROM gcr.io/distroless/cc:nonroot
WORKDIR /
COPY --from=builder /mediaedge/target/release/mediaedgectl /mediaedgectl
COPY --from=builder /mediaedge/target/release/mediaedge-gateway /mediaedge-gateway
COPY --from=builder /mediaedge/target/release/mediaedge-edge-node /mediaedge-edge-node
COPY --from=builder /mediaedge/target/release/mediaedge-media-processor /mediaedge-media-processor
COPY --from=builder /mediaedge/target/release/mediaedge-storage-node /mediaedge-storage-node
COPY --from=builder /mediaedge/target/release/mediaedge-replication-coordinator /mediaedge-replication-coordinator
CMD ["/mediaedgectl"]